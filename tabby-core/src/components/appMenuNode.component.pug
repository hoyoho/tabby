.app-menu-group([class.indented]='depth > 1')
    ng-container(*ngIf='hasChildren')
        button.app-menu-header(
            [class.expanded]='expanded',
            (click)='toggle()',
        )
            span {{item.label | translate}}
            i.fa.fa-chevron-right.app-menu-chevron
        .app-menu-body(*ngIf='expanded')
            ng-container(*ngFor='let child of item.children')
                .dropdown-divider(*ngIf='child.separatorBefore')
                ng-container(*ngIf='child.type !== "separator"')
                    app-menu-node(
                        *ngIf='child.children?.length',
                        [item]='child',
                        [depth]='depth + 1',
                        [onRun]='onRun',
                    )
                    button.dropdown-item(
                        *ngIf='!child.children?.length',
                        [disabled]='!isEnabled(child)',
                        [class.checked]='isChecked(child)',
                        (click)='runItem(child)',
                    )
                        i.fa.fa-check.me-1(*ngIf='isChecked(child)')
                        span {{child.label | translate}}
    ng-container(*ngIf='!hasChildren')
        button.dropdown-item(
            [disabled]='!enabled',
            [class.checked]='checked',
            (click)='runItem(item)',
        )
            i.fa.fa-check.me-1(*ngIf='checked')
            span {{item.label | translate}}
