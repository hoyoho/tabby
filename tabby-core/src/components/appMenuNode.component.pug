ng-container(*ngIf='hasChildren')
    .app-menu-sub(
        (mouseenter)='setSubOpen(true)',
        (mouseleave)='setSubOpen(false)',
        (focusin)='setSubOpen(true)',
        [class.open]='subOpen'
    )
        button.dropdown-item.app-menu-sub-toggle(
            type='button',
            (click)='openSub()',
        )
            span.app-menu-item-icon(*ngIf='depth > 0')
            span.app-menu-item-label {{item.label | translate}}
            i.fa.fa-chevron-right.app-menu-chevron
        .app-menu-submenu(
            *ngIf='subOpen',
            [class.has-nested]='hasNestedChildren'
        )
            ng-container(*ngFor='let child of item.children')
                .dropdown-divider(*ngIf='child.separatorBefore')
                ng-container(*ngIf='child.type !== "separator"')
                    app-menu-node(
                        *ngIf='child.children?.length',
                        [item]='child',
                        [onRun]='onRun',
                        [resetKey]='resetKey',
                        [depth]='depth + 1',
                    )
                    button.dropdown-item(
                        *ngIf='!child.children?.length',
                        [disabled]='!isEnabled(child)',
                        [class.checked]='isChecked(child)',
                        (click)='runItem(child)',
                    )
                        span.app-menu-item-icon
                            i.fa.fa-check.app-menu-check(*ngIf='isChecked(child)')
                        span.app-menu-item-label {{child.label | translate}}

ng-container(*ngIf='!hasChildren')
    button.dropdown-item(
        [disabled]='!enabled',
        [class.checked]='checked',
        (click)='runItem(item)',
    )
        span.app-menu-item-icon(*ngIf='depth > 0')
            i.fa.fa-check.app-menu-check(*ngIf='checked')
        span.app-menu-item-label {{item.label | translate}}
