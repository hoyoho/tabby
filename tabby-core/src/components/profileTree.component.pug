.p-2.h-100.d-flex.flex-column((contextmenu)='blankContextMenu($event)', (dragover)='allowDrop($event)', (drop)='onBlankDrop($event)')
    input.form-control.form-control-sm.mb-1(
        type='text',
        [(ngModel)]='filter',
        [placeholder]='"Filter"|translate',
        (ngModelChange)='onFilterChange()'
    )

    .profile-tree.h-100
        .d-flex.flex-column.p-2.profile-tree-container
            ng-container(*ngFor='let group of rootGroups')
                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

            ng-template(#recursiveGroup let-group let-depth='depth')
                ng-container(*ngIf='group.id === "default"')
                    ng-container(*ngFor='let profile of group.profiles')
                        a.tree-item(
                            (dblclick)='launchProfile(profile)',
                            [style.paddingLeft.px]='depth * 20',
                            draggable='true',
                            (dragstart)='onProfileDragStart(profile, $event)',
                            (dragover)='allowDrop($event)',
                            (drop)='onProfileDrop($event, group)',
                            (contextmenu)='profileContextMenu(profile, $event)',
                            href='#'
                        )
                            .fw-20
                                profile-icon.ms-1([icon]='profile.icon', [color]='profile.color')
                            span.me-2.me-auto.no-wrap {{ profile.name }}
                            .actions
                                .action((click)='launchProfile(profile)')
                                    i.fa.fa-fw.fas.fa-play

                    ng-container(*ngFor='let child of group.children')
                        ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

                ng-container(*ngIf='group.id !== "default"')
                    a.tree-item(
                        draggable='true',
                        (dragstart)='onGroupDragStart(group, $event)',
                        (click)='toggleGroupCollapse(group)',
                        (dragover)='allowDrop($event)',
                        (drop)='onProfileDrop($event, group)',
                        [style.paddingLeft.px]='depth * 20',
                        (contextmenu)='groupContextMenu(group, $event)',
                        href='#'
                    )
                        .fw-20
                            i.fa.fa-fw.fa-chevron-right.me-1.text-muted(*ngIf='group.collapsed')
                            i.fa.fa-fw.fa-chevron-down.me-1.text-muted(*ngIf='!group.collapsed')
                        .fw-20
                            profile-icon.me-1([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                        span.me-2.no-wrap {{ group.name || ("Ungrouped"|translate) }}

                    ng-container(*ngIf='!group.collapsed')
                        ng-container(*ngFor='let profile of group.profiles')
                            a.tree-item(
                                (dblclick)='launchProfile(profile)',
                                [style.paddingLeft.px]='(depth + 1) * 20',
                                draggable='true',
                                (dragstart)='onProfileDragStart(profile, $event)',
                                (dragover)='allowDrop($event)',
                                (drop)='onProfileDrop($event, group)',
                                (contextmenu)='profileContextMenu(profile, $event)',
                                href='#'
                            )
                                .fw-20
                                    profile-icon.me-1([icon]='profile.icon', [color]='profile.color')
                                span.me-2.me-auto.no-wrap {{ profile.name }}
                                .actions
                                    .action((click)='launchProfile(profile)')
                                        i.fa.fa-fw.fa-play

                        ng-container(*ngFor='let child of group.children')
                            ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

.sash(
    (mousedown)='startResize($event)'
)