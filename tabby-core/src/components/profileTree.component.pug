.p-2.h-100.d-flex.flex-column((contextmenu)='blankContextMenu($event)', (dragover)='allowDrop($event)', (drop)='onBlankDrop($event)')
    input.form-control.form-control-sm.mb-1(
        type='text',
        [(ngModel)]='filter',
        [placeholder]='"Filter"|translate',
        (ngModelChange)='onFilterChange()'
    )

    .profile-tree
        .d-flex.flex-column.p-2.profile-tree-container
            ng-container(*ngFor='let group of rootGroups')
                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

            ng-template(#recursiveGroup let-group let-depth='depth')
                ng-container(*ngIf='group.id === "default"')
                    ng-container(*ngFor='let profile of group.profiles')
                        a.tree-item(
                            (click)='selectPreview(profile)',
                            (dblclick)='launchProfile(profile)',
                            [style.paddingLeft.px]='depth * 20',
                            draggable='true',
                            (dragstart)='onProfileDragStart(profile, $event)',
                            (dragover)='allowDrop($event)',
                            (drop)='onProfileDrop($event, group)',
                            (contextmenu)='profileContextMenu(profile, $event)',
                            [ngbTooltip]='tooltipFor(profile, group)',
                            [disableTooltip]='!tooltipFor(profile, group)',
                            href='#'
                        )
                            profile-icon([icon]='profile.icon', [color]='profile.color')
                            span.me-2.me-auto.no-wrap {{ profile.name }}
                            .actions
                                .action((click)='launchProfile(profile)')
                                    i.fa.fa-fw.fas.fa-play

                    ng-container(*ngFor='let child of group.children')
                        ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

                ng-container(*ngIf='group.id !== "default"')
                    a.tree-item(
                        draggable='true',
                        (dragstart)='onGroupDragStart(group, $event)',
                        (click)='toggleGroupCollapse(group)',
                        (dragover)='allowDrop($event)',
                        (drop)='onProfileDrop($event, group)',
                        [style.paddingLeft.px]='depth * 20',
                        (contextmenu)='groupContextMenu(group, $event)',
                        href='#'
                    )
                            i.fa.fa-fw.fa-chevron-right.text-muted(*ngIf='group.collapsed')
                            i.fa.fa-fw.fa-chevron-down.text-muted(*ngIf='!group.collapsed')
                            profile-icon([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                            span.me-2.no-wrap {{ group.name || ("Ungrouped"|translate) }}

                    ng-container(*ngIf='!group.collapsed')
                        ng-container(*ngFor='let profile of group.profiles')
                            a.tree-item(
                                (click)='selectPreview(profile)',
                                (dblclick)='launchProfile(profile)',
                                [style.paddingLeft.px]='(depth + 1) * 20',
                                draggable='true',
                                (dragstart)='onProfileDragStart(profile, $event)',
                                (dragover)='allowDrop($event)',
                                (drop)='onProfileDrop($event, group)',
                                (contextmenu)='profileContextMenu(profile, $event)',
                                [ngbTooltip]='tooltipFor(profile, group)',
                                [disableTooltip]='!tooltipFor(profile, group)',
                                href='#'
                            )
                                    profile-icon([icon]='profile.icon', [color]='profile.color')
                                    span.me-2.me-auto.no-wrap {{ profile.name }}
                                    .actions
                                        .action((click)='launchProfile(profile)')
                                            i.fa.fa-fw.fa-play

                        ng-container(*ngFor='let child of group.children')
                            ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

    //- Session indicator: focused session only, hidden as soon as focus leaves
    //- an SSH tab. Suppressed while a profile preview is on screen.
    .connection-info(*ngIf='connectionInfo && !previewInfo')
        span.conn-dot([class.connected]='connectionInfo.connected')
        .conn-text
            span.conn-name.no-wrap {{ connectionInfo.name }}
            span.conn-addr.no-wrap {{ connectionInfo.user }}@{{ connectionInfo.host }}:{{ connectionInfo.port }}

    //- Profile preview: the sidebar profile last clicked, independent of the
    //- session indicator above.
    .profile-preview(*ngIf='previewInfo')
        table.preview-table
            tr
                td.label(translate) Name
                td.value {{ previewInfo.name }}
            tr
                td.label(translate) Protocol
                td.value {{ previewInfo.protocol }}
            tr(*ngIf='previewInfo.host')
                td.label(translate) Host
                td.value {{ previewInfo.host }}
            tr(*ngIf='previewInfo.port')
                td.label(translate) Port
                td.value {{ previewInfo.port }}
            tr(*ngIf='previewInfo.user')
                td.label(translate) Username
                td.value {{ previewInfo.user }}
