div.app-menu-root(ngbDropdown, #menuDropdown='ngbDropdown', container='body', (openChange)='onOpen($event)')
    button.btn.app-menu-btn(
        ngbDropdownToggle,
        aria-label='Menu',
        (dblclick)='$event.stopPropagation()',
    )
        svg(width='14', height='14', viewBox='0 0 14 14')
            path(d='M1.5 4h11M1.5 7h11M1.5 10h11', stroke='currentColor', stroke-width='1.4', stroke-linecap='round')
    .dropdown-menu.app-menu(
        ngbDropdownMenu
    )
        ng-container(*ngFor='let menu of menus')
            .app-menu-section(*ngIf='menu.children?.length')
                button.app-menu-header(
                    [class.expanded]='isExpanded(menu)',
                    (click)='toggle(menu)',
                )
                    span {{menu.label | translate}}
                    i.fa.fa-chevron-right.app-menu-chevron
                .app-menu-body(*ngIf='isExpanded(menu)')
                    ng-container(*ngFor='let child of menu.children')
                        .dropdown-divider(*ngIf='child.separatorBefore')
                        ng-container(*ngIf='child.type !== "separator"')
                            app-menu-node(
                                *ngIf='child.children?.length',
                                [item]='child',
                                [depth]='1',
                                [onRun]='run',
                            )
                            button.dropdown-item(
                                *ngIf='!child.children?.length',
                                [disabled]='!isEnabled(child)',
                                [class.checked]='isChecked(child)',
                                (click)='run(child)',
                            )
                                i.fa.fa-check.me-1(*ngIf='isChecked(child)')
                                span {{child.label | translate}}
