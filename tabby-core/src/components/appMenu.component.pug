div.app-menu-root(ngbDropdown, #menuDropdown='ngbDropdown', autoClose='outside', container='body', (openChange)='onOpen($event)')
    button.btn.app-menu-btn(
        ngbDropdownToggle,
        [attr.aria-label]="'Menu' | translate",
        (dblclick)='$event.stopPropagation()',
    )
        svg(width='14', height='14', viewBox='0 0 14 14')
            path(d='M1.5 4h11M1.5 7h11M1.5 10h11', stroke='currentColor', stroke-width='1.4', stroke-linecap='round')
    .dropdown-menu.app-menu(
        ngbDropdownMenu
    )
        ng-container(*ngFor='let menu of menus')
            app-menu-node(
                *ngIf='menu.children?.length',
                [item]='menu',
                [onRun]='run',
                [resetKey]='generation',
            )
